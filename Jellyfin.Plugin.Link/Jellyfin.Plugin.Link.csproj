<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.Link</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Link</RootNamespace>
    <!-- Jellyfin reports this assembly version in the dashboard and keys the
         enable/disable/uninstall API routes off the version in the plugin's
         meta.json. The two must match, so keep this in step with the version
         in build.yaml and manifest.json. CI overrides it from build.yaml. -->
    <Version>1.0.1.0</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.9.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\link.html" />
    <EmbeddedResource Include="Web\link.css" />
    <EmbeddedResource Include="Web\link.js" />
  </ItemGroup>

</Project>
